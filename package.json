{
  "name": "petit-a-petit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run validate:shared && tsc -b && vite build",
    "publish:library": "bun scripts/publish-library.ts",
    "validate:shared": "bun scripts/validate-shared-library.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write src scripts tests docs README.md *.json *.ts *.js index.html",
    "test": "bun test tests/data.test.ts tests/publishing.test.ts",
    "test:browser": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
